# Configurações da Aplicação
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=sua_chave_secreta_super_segura_aqui

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pythonfirst_db
DB_USER=postgres
DB_PASSWORD=postgres

# API Keys para Módulos de IA (Opcional)
OPENAI_API_KEY=sk-proj-exemplo-sua-chave-aqui
